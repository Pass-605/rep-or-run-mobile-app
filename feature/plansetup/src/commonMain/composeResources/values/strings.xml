<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Preferencias del bloque (pantalla 04 de Figma). -->
    <string name="prefs_title">Tu semana</string>
    <string name="prefs_back">Volver</string>
    <string name="prefs_continue">Continuar</string>

    <!-- Días disponibles -->
    <string name="prefs_days">Días disponibles</string>
    <plurals name="prefs_days_selected">
        <item quantity="one">%1$d elegido</item>
        <item quantity="other">%1$d elegidos</item>
    </plurals>
    <!-- Lo que se lee en el chip de cada día: una letra, como en Figma. -->
    <string name="prefs_day_monday_initial">L</string>
    <string name="prefs_day_tuesday_initial">M</string>
    <string name="prefs_day_wednesday_initial">X</string>
    <string name="prefs_day_thursday_initial">J</string>
    <string name="prefs_day_friday_initial">V</string>
    <string name="prefs_day_saturday_initial">S</string>
    <string name="prefs_day_sunday_initial">D</string>
    <!-- Lo que anuncia ese chip, y el día de «Empieza el lunes 21/09». -->
    <string name="prefs_day_monday_name">lunes</string>
    <string name="prefs_day_tuesday_name">martes</string>
    <string name="prefs_day_wednesday_name">miércoles</string>
    <string name="prefs_day_thursday_name">jueves</string>
    <string name="prefs_day_friday_name">viernes</string>
    <string name="prefs_day_saturday_name">sábado</string>
    <string name="prefs_day_sunday_name">domingo</string>
