    <string name="prefs_day_monday">Lun</string>
    <string name="prefs_day_tuesday">Mar</string>
    <string name="prefs_day_wednesday">Mié</string>
    <string name="prefs_day_thursday">Jue</string>
    <string name="prefs_day_friday">Vie</string>
    <string name="prefs_day_saturday">Sáb</string>
    <string name="prefs_day_sunday">Dom</string>

