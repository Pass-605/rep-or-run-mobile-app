    <!-- Aviso de privacidad del texto libre. Dice lo mismo que el aviso completo del onboarding: no se cambia sin preguntar. -->
    <string name="profile_free_text_privacy">Lo que escribas aquí se envía a OpenAI al generar el plan, igual que el resto del perfil. No pongas tu nombre ni datos que te identifiquen.</string>

    <!--
        Tarjeta del objetivo. Son constantes de la app, no salida del modelo: una por objetivo,
        iguales para todas las personas. El de recomposición es el de Figma, literal.
    -->
    <string name="profile_goal_card_meaning_title">Qué significa %1$s</string>
    <string name="profile_goal_card_changes_title">Cómo cambia tu plan</string>
    <string name="profile_goal_card_reps">Repeticiones</string>
    <string name="profile_goal_card_volume">Volumen</string>
    <string name="profile_goal_card_rest">Descanso</string>
    <string name="profile_goal_card_cardio">Cardio</string>

    <string name="profile_goal_recomposition_meaning">Ganar algo de músculo y perder grasa a la vez. Es el camino más lento en las dos direcciones: en 14 días lo que se mueve son las cargas, no la báscula.</string>
    <string name="profile_goal_recomposition_reps">8-12 por serie</string>
    <string name="profile_goal_recomposition_volume">Repartido entre grupos</string>
    <string name="profile_goal_recomposition_rest">1,5-2,5 min</string>
    <string name="profile_goal_recomposition_cardio">En los días sin fuerza</string>

    <string name="profile_goal_hypertrophy_meaning">Ganar masa muscular. El plan da más series a los grupos que marques como prioritarios. En 14 días no se mide músculo nuevo: el primer bloque sirve para calibrar las cargas.</string>
    <string name="profile_goal_hypertrophy_reps">8-15 por serie</string>
    <string name="profile_goal_hypertrophy_volume">Más en tus prioridades</string>
    <string name="profile_goal_hypertrophy_rest">1-2 min</string>
    <string name="profile_goal_hypertrophy_cardio">Corto y suave</string>

    <string name="profile_goal_strength_meaning">Mover más carga en los ejercicios principales. Menos repeticiones por serie y descansos más largos, para llegar a cada serie con fuerzas.</string>
    <string name="profile_goal_strength_reps">5-8 por serie</string>
    <string name="profile_goal_strength_volume">Menos series, más pesadas</string>
    <string name="profile_goal_strength_rest">2-4 min</string>
    <string name="profile_goal_strength_cardio">Corto y suave</string>

    <string name="profile_goal_general_fitness_meaning">Entrenar todo el cuerpo con regularidad, sin perseguir marcas. Sesiones equilibradas, con fuerza y cardio en proporciones parecidas.</string>
    <string name="profile_goal_general_fitness_reps">10-15 por serie</string>
    <string name="profile_goal_general_fitness_volume">Equilibrado</string>
    <string name="profile_goal_general_fitness_rest">1-1,5 min</string>
    <string name="profile_goal_general_fitness_cardio">En todas las semanas</string>

    <!-- Nota fija, la misma para los cuatro objetivos. Es la regla de dominio de «sin pautas de alimentación», no un texto de relleno. -->
    <string name="profile_goal_card_no_nutrition">Ningún objetivo incluye pautas de alimentación ni suplementos: Rep or Run solo ajusta el entrenamiento.</string>

