{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gymdi.app/contract/v1/common.schema.json",
  "title": "Gymdi · tipos comunes v1",
  "description": "Enums y objetos compartidos por los contratos de generacion y revision. No se envia a OpenAI: las peticiones lo usan por $ref; los esquemas que consume el modelo son autocontenidos.",
  "$defs": {
    "SchemaVersion": { "const": "1" },
    "PromptVersion": { "type": "string", "pattern": "^[a-z0-9-]+-v[0-9]+$" },
    "Locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "IsoDate": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "IsoDateTime": { "type": "string", "format": "date-time" },

    "DayOfWeek": { "enum": ["MONDAY","TUESDAY","WEDNESDAY","THURSDAY","FRIDAY","SATURDAY","SUNDAY"] },
    "Experience": { "enum": ["BEGINNER","INTERMEDIATE","ADVANCED"] },
    "Goal": { "enum": ["RECOMPOSITION","HYPERTROPHY","STRENGTH","GENERAL_FITNESS"] },
    "MuscleGroup": { "enum": ["CHEST","BACK","SHOULDERS","BICEPS","TRICEPS","FOREARMS","QUADS","HAMSTRINGS","GLUTES","ABDUCTORS","ADDUCTORS","CALVES","CORE","FULL_BODY"] },
    "EquipmentCategory": { "enum": ["MACHINE","CABLE","FREE_WEIGHT","SMITH","BENCH","CARDIO","BODYWEIGHT","OTHER"] },
    "LoadType": {
      "description": "Convencion de carga (plan §4.5): SELECTOR = numero de la pila; PLATES_TOTAL = discos totales; SMITH = discos + barra si se conoce; SLED = carro (el vacio ya pesa); DUMBBELL = por mancuerna; BARBELL = barra + discos; BODYWEIGHT = 0 kg sin lastre; CARDIO = sin carga externa; NONE = no aplica.",
      "enum": ["SELECTOR","PLATES_TOTAL","SMITH","SLED","DUMBBELL","BARBELL","BODYWEIGHT","CARDIO","NONE"]
    },
    "Metric": { "enum": ["REPS","METERS","SECONDS"] },
    "Unit": { "enum": ["KG"] },
    "DataQuality": { "enum": ["SUFFICIENT","LIMITED","INSUFFICIENT"] },
    "ProposalType": { "enum": ["KEEP","INCREASE_LOAD","ADJUST_REPS","ADJUST_SETS","SWAP_EXERCISE","MOVE_DAY","ADJUST_CARDIO","OTHER"] },
    "Confidence": { "enum": ["LOW","MEDIUM","HIGH"] },
    "FeedbackRating": { "enum": ["TOO_EASY","OK","TOO_HARD","NOT_DONE"] },

    "EquipmentId": { "type": "string", "pattern": "^eq_[A-Za-z0-9_-]{1,32}$" },
    "ExerciseCode": {
      "description": "Codigo del ejercicio dentro del plan, como en el paquete TNT: letra del dia + orden (L01, X04).",
      "type": "string",
      "pattern": "^[A-Z]{1,2}[0-9]{2}$"
    },

    "Profile": {
      "type": "object",
      "description": "UserProfile del plan §10 sin id ni updatedAt. Sin nombre real: alias opcional.",
      "properties": {
        "alias": { "type": ["string","null"], "maxLength": 40 },
        "age": { "type": "integer", "minimum": 16, "maximum": 100 },
        "heightCm": { "type": "number", "minimum": 120, "maximum": 230 },
        "weightKg": { "type": ["number","null"], "minimum": 30, "maximum": 300 },
        "waistCm": { "type": ["number","null"], "minimum": 40, "maximum": 200 },
        "hipCm": { "type": ["number","null"], "minimum": 40, "maximum": 200 },
        "experience": { "$ref": "#/$defs/Experience" },
        "goal": { "$ref": "#/$defs/Goal" },
        "priorityMuscles": { "type": "array", "items": { "$ref": "#/$defs/MuscleGroup" }, "maxItems": 4, "uniqueItems": true },
        "limitations": { "type": "string", "maxLength": 600, "description": "Texto libre. Se respeta como restriccion; no se interpreta clinicamente (plan §4.9)." },
        "preferences": { "type": "string", "maxLength": 600 }
      },
      "required": ["age","heightCm","experience","goal","priorityMuscles","limitations","preferences"],
      "additionalProperties": false
    },

    "Equipment": {
      "type": "object",
      "description": "Maquina del inventario del gimnasio activo. Solo se envian las que la persona marco como disponibles.",
      "properties": {
        "id": { "$ref": "#/$defs/EquipmentId" },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "category": { "$ref": "#/$defs/EquipmentCategory" },
        "loadType": { "$ref": "#/$defs/LoadType" },
        "minKg": { "type": ["number","null"], "minimum": 0, "maximum": 500 },
        "maxKg": { "type": ["number","null"], "minimum": 0, "maximum": 1000 },
        "incrementKg": { "type": ["number","null"], "exclusiveMinimum": 0, "maximum": 50 },
        "notes": { "type": ["string","null"], "maxLength": 200 }
      },
      "required": ["id","name","category","loadType"],
      "additionalProperties": false
    },

    "Gym": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "equipment": { "type": "array", "items": { "$ref": "#/$defs/Equipment" }, "minItems": 1, "maxItems": 120 }
      },
      "required": ["name","equipment"],
      "additionalProperties": false
    },

    "BlockPreferences": {
      "type": "object",
      "properties": {
        "availableDays": { "type": "array", "items": { "$ref": "#/$defs/DayOfWeek" }, "minItems": 1, "maxItems": 7, "uniqueItems": true },
        "sessionMinutes": { "type": "integer", "minimum": 20, "maximum": 180 },
        "blockDays": { "const": 14, "description": "v1 fija bloques de 14 dias; otro valor exige schemaVersion 2." },
        "startDate": { "anyOf": [{ "$ref": "#/$defs/IsoDate" }, { "type": "null" }] },
        "cardioModes": { "type": "array", "items": { "type": "string", "maxLength": 40 }, "maxItems": 6, "uniqueItems": true },
        "avoidExercises": { "type": "string", "maxLength": 400 },
        "unit": { "$ref": "#/$defs/Unit" }
      },
      "required": ["availableDays","sessionMinutes","blockDays","cardioModes","avoidExercises","unit"],
      "additionalProperties": false
    },

    "Usage": {
      "type": "object",
      "properties": {
        "promptTokens": { "type": "integer", "minimum": 0 },
        "completionTokens": { "type": "integer", "minimum": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 }
      },
      "required": ["promptTokens","completionTokens","totalTokens"],
      "additionalProperties": false
    }
  }
}
