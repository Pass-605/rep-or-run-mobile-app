<?xml version="1.0" encoding="utf-8"?>
<!--
    Solo debug. Permite HTTP en claro hacia el runner local de la Lambda (10.0.2.2 es el
    host visto desde el emulador) y hacia nada más: el resto sigue exigiendo HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
